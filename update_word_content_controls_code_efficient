    if not tag_elements:
      continue
 
    tag = tag_elements[0].get(qn("w:val"))
 
    if tag in text_tags:
    #call function to update text control if matched
      update_text_content_control(
      sdt,
      str(text_tags[tag])
      )
 
    elif tag in image_tags:
    #call function to update pic control if matched
      update_pic_content_control(
      part or document.part,
      sdt,
      image_tags[tag]
      )

#function to process the document
def process_document(doc_path,text_tags,image_tags=None):
